<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- MUTHUR, not MU/TH/UR: a slash is illegal in a filename, and this name
	     reaches the filesystem. The slashed form is drawn, never stored. -->
	<key>CFBundleName</key>
	<string>MUTHUR</string>
	<key>CFBundleDisplayName</key>
	<string>MUTHUR</string>
	<key>CFBundleExecutable</key>
	<string>MUTHUR</string>
	<key>CFBundleIdentifier</key>
	<string>com.gvorbeck.muthur</string>
	<!-- App/MUTHUR.icns, which the synchronized App group copies into
	     Contents/Resources by itself. **A placeholder** — generated by
	     Scripts/make-icon.sh out of the panel's own Theme and character
	     generator, so it is the right amber rather than the right mark.
	     Replacing it means dropping a different MUTHUR.icns in beside this
	     file; nothing else here has to change. -->
	<key>CFBundleIconFile</key>
	<string>MUTHUR</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Quoted from the build settings, not written down a second time. The
	     number lived here as a literal while MARKETING_VERSION sat in the
	     project file being ignored, which is the same trap docs/parity.md's
	     count keeps falling into: one number written twice is two numbers the
	     moment only one of them is updated. -->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- It has its own Dock icon and Cmd-Tab identity (spec.md), so it is a
	     regular app and not an agent. -->
	<key>LSUIElement</key>
	<false/>
	<key>NSHumanReadableCopyright</key>
	<string></string>
</dict>
</plist>
